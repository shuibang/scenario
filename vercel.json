{
  "redirects": [
    { "source": "/landing.html",  "destination": "/",          "permanent": true },
    { "source": "/help.html",     "destination": "/help",      "permanent": true },
    { "source": "/notice.html",   "destination": "/notice",    "permanent": true },
    { "source": "/changelog.html","destination": "/changelog", "permanent": true },
    { "source": "/template.html", "destination": "/template",  "permanent": true },
    { "source": "/devlog-1.html", "destination": "/devlog-1",  "permanent": true },
    { "source": "/devlog-2.html", "destination": "/devlog-2",  "permanent": true },
    { "source": "/devlog-3.html", "destination": "/devlog-3",  "permanent": true },
    { "source": "/about.html",    "destination": "/about",     "permanent": true },
    { "source": "/contact.html",  "destination": "/contact",   "permanent": true },
    { "source": "/privacy.html",  "destination": "/privacy",   "permanent": true },
    { "source": "/terms.html",    "destination": "/terms",     "permanent": true }
  ],
  "rewrites": [
    { "source": "/help",      "destination": "/help.html"     },
    { "source": "/notice",    "destination": "/notice.html"   },
    { "source": "/changelog", "destination": "/changelog.html"},
    { "source": "/template",  "destination": "/template.html" },
    { "source": "/devlog-1",  "destination": "/devlog-1.html" },
    { "source": "/devlog-2",  "destination": "/devlog-2.html" },
    { "source": "/devlog-3",  "destination": "/devlog-3.html" },
    { "source": "/about",     "destination": "/about.html"    },
    { "source": "/contact",   "destination": "/contact.html"  },
    { "source": "/privacy",   "destination": "/privacy.html"  },
    { "source": "/terms",     "destination": "/terms.html"    },
    { "source": "/app",       "destination": "/app.html"      },
    { "source": "/app/(.*)",  "destination": "/app.html"      }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), camera=(), microphone=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://*.google-analytics.com https://*.googlesyndication.com https://*.adtrafficquality.google https://googleads.g.doubleclick.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://www.googleapis.com https://accounts.google.com https://*.google-analytics.com https://*.analytics.google.com https://*.googlesyndication.com https://*.adtrafficquality.google https://googleads.g.doubleclick.net https://*.gstatic.com https://cdn.jsdelivr.net; font-src 'self' data: https://cdn.jsdelivr.net; frame-src https://googleads.g.doubleclick.net https://*.googlesyndication.com https://*.adtrafficquality.google https://ep1.adtrafficquality.google https://ep2.adtrafficquality.google https://www.google.com; object-src 'none'; base-uri 'self';" }
      ]
    }
  ]
}
