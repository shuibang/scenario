# Google OAuth 2.0 Client ID
# Create at: https://console.cloud.google.com/apis/credentials
# Set "Authorized JavaScript origins" to http://localhost:5173 for local dev
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# TMDB API Key (드라마 추천 기능에 사용)
# Create at: https://www.themoviedb.org/settings/api
# 이 키 없이도 앱 기본 기능(대본 작성)은 정상 동작합니다
VITE_TMDB_API_KEY=YOUR_TMDB_API_KEY

# ─── 어드민 페이지 (운영자 본인 전용 현황 대시보드) ───────────────────────
# 두 값 모두 설정해야 어드민 진입이 가능합니다. 미설정 시 라우트 자체 비활성.
# 실제 데이터 가드는 Supabase RLS(public.is_admin_user())에 있고, 이 값들은
# UI 노출 / 진입 버튼 표시 제어용입니다.
#
# 화이트리스트 이메일 (쉼표 구분). 코드 폴백은 gptbuja@gmail.com.
VITE_ADMIN_EMAILS=admin@example.com
# 예측하기 어려운 라우트 토큰. URL은 daejak.kr/app#__a-<TOKEN> 형태가 됩니다.
# 누설되어도 RLS가 차단하지만, 가끔 교체 권장.
VITE_ADMIN_PATH_TOKEN=changeme
